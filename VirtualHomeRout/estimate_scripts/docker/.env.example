# Absolute host path to VirtualHome dataset directory mounted into container.
# Expected to contain executable task .txt files.
VH_DATASET_VOLUME=C:/data/virtualhome/executable_programs

# Absolute host path to Unity binary folder mounted into container.
# Default UI path expects /volumes/unity/VirtualHome.x86_64
VH_UNITY_VOLUME=C:/data/virtualhome/unity_linux_exec
# Unity executable path inside container (must exist under /volumes/unity)
# Linux example: /volumes/unity/VirtualHome.x86_64
# Windows build example (not for linux container runtime): /volumes/unity/VirtualHome.exe
VH_UNITY_EXE=/volumes/unity/VirtualHome.x86_64

# Optional heavy CALVIN repo mount (for future extension / shared storage).
CALVIN_VOLUME=C:/data/calvin
