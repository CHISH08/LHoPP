# Absolute host path to CALVIN repository root (contains calvin_models/, calvin_env/, ...)
CALVIN_REPO_VOLUME=C:/data/calvin_repo

# Absolute host path to CALVIN dataset root (for example task_D_D)
CALVIN_DATASET_VOLUME=C:/data/calvin_dataset/task_D_D

# Persistent protocol/contracts volume
CALVIN_PROTOCOL_VOLUME=C:/data/calvin_benchmark/protocol_bundle

# Persistent benchmark runs/logs volume
CALVIN_RUNS_VOLUME=C:/data/calvin_benchmark/runs

# Persistent smoke/integration test runs volume
CALVIN_TEST_RUNS_VOLUME=C:/data/calvin_benchmark/test_runs

# Optional folder with custom model server scripts
CALVIN_MODEL_SCRIPTS_VOLUME=C:/data/calvin_benchmark/model_scripts
